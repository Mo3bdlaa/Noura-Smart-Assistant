# --- Database (Postgres + pgvector) ---
# For local dev with the provided docker-compose:
DATABASE_URL="postgres://noura:noura@localhost:5432/noura"

# --- Gemini (Google GenAI) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Chat model (fallback: gemini-2.0-flash). Embeddings are fixed to text-embedding-004 (768 dims).
GEMINI_CHAT_MODEL="gemini-2.5-flash"

# --- Sessions ---
# Must be at least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Admin bootstrap (used by `npm run db:seed`) ---
ADMIN_EMAIL="mo3bdlaa.bot@gmail.com"
ADMIN_PASSWORD="change-me-strong-password"

# --- Feature flags ---
# Whether public self-registration is open. If "false", accounts are invite/admin-created only.
REGISTRATION_OPEN="true"
